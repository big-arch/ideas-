# Copy to .env. Never put real tokens into Git or chat messages.
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=
# Private Telegram chat IDs, comma separated. No public access by default.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional single-owner onboarding, generated during setup. Keep private.
TELEGRAM_PAIRING_CODE=
# Optional local Ollama model already installed on this computer.
# No model downloads or cloud API calls are made by this app.
OLLAMA_MODEL=
